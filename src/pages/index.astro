---
import Layout from '../layouts/Layout.astro';
import KForm from '../components/KForm.astro';
import { mainObjects, minorObjects, allObjects } from '../data/collection';
const description =
	"Product and UX designer working in the in-between of design, technology, and human connection. Enterprise software at Ericsson, a permanent museum installation, and a platform used by 2,700+ institutions.";
---
<Layout title="Nikos Saoulidis — Product & UX Designer, Gothenburg" description={description} currentPage="work">
	<div class="cat-page">
		<section class="cat-intro">
			<div class="wrap cat-intro-grid">
				<div>
					<h1 class="cat-name">Nikos Saoulidis</h1>
					<p class="cat-role">Product and UX designer, Gothenburg.</p>
					<p class="cat-line">I came into design sideways, from engineering, and stayed for the human part of it.</p>
				</div>
				<div class="cat-forms" aria-hidden="true">
					<KForm form="circle" class="cf-circle" />
					<KForm form="square" class="cf-square" />
					<KForm form="triangle" class="cf-triangle" />
				</div>
			</div>
		</section>

		<section class="catalogue" id="work" aria-labelledby="collection-title">
			<div class="wrap cat-grid">
				<div class="cat-list">
					<h2 id="collection-title" class="visually-hidden">The collection</h2>
					<div class="cat-head" aria-hidden="true">
						<span>No.</span><span>Object</span><span>Status</span>
					</div>
					<ol class="cat-index cat-main">
						{mainObjects.map((o) => (
							<li>
								<a class="cat-row" href={o.href} data-no={o.no} data-form={o.form}>
									<picture class="cat-plate">
										{o.image.webp && <source srcset={o.image.webp} type="image/webp" />}
										<img src={o.image.src} width={o.image.width} height={o.image.height} alt="" loading="lazy" style={o.image.position ? `object-position: ${o.image.position}` : undefined} />
									</picture>
									<span class="cat-no">{o.no}{o.form && <KForm form={o.form} class="cat-mark" />}</span>
									<span class="cat-body">
										<span class="cat-object">{o.title}</span>
										<span class="cat-meta">{o.year} · {o.medium}</span>
										<span class="cat-summary">{o.summary}</span>
									</span>
									<span class="cat-status">{o.status}</span>
								</a>
							</li>
						))}
					</ol>

					<h3 class="cat-subtitle">Also in the collection</h3>
					<ol class="cat-index cat-minor">
						{minorObjects.map((o) => (
							<li>
								<a class="cat-row" href={o.href} data-no={o.no} target="_blank" rel="noopener">
									<picture class="cat-thumb">
										{o.image.webp && <source srcset={o.image.webp} type="image/webp" />}
										<img src={o.image.src} width={o.image.width} height={o.image.height} alt="" loading="lazy" style={o.image.position ? `object-position: ${o.image.position}` : undefined} />
									</picture>
									<span class="cat-no">{o.no}</span>
									<span class="cat-body">
										<span class="cat-object">{o.title}</span>
										<span class="cat-meta">{o.year} · {o.medium} · <span class="cat-ext">{o.linkLabel}<span class="visually-hidden"> (opens in a new tab)</span></span></span>
									</span>
									<span class="cat-status">{o.status}</span>
								</a>
							</li>
						))}
					</ol>

					<p class="fs-small cat-deck">
						There's also a <a href="https://www.figma.com/deck/pygH7CpZVJ0LSkNgFMkvkw" target="_blank" rel="noopener">full case deck</a> if you want more depth on a couple of these.
					</p>
				</div>

				<div class="cat-case" aria-hidden="true">
					<div class="cat-case-frame">
						{allObjects.map((o, i) => (
							<figure class:list={['cat-case-item', o.image.contain && 'is-contain']} data-no={o.no}>
								<picture>
									{o.image.webp && <source srcset={o.image.webp} type="image/webp" />}
									<img src={o.image.src} width={o.image.width} height={o.image.height} alt="" loading={i === 0 ? 'eager' : 'lazy'} style={o.image.position ? `object-position: ${o.image.position}` : undefined} />
								</picture>
								<figcaption class="cat-case-label">
									<span class="cat-no">No. {o.no}</span>
									<span>{o.title}</span>
								</figcaption>
							</figure>
						))}
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>
