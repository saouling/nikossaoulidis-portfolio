---
// One template for every tier-1 case study, at /ericsson/, /ewp-dashboard/,
// /dont-be-a-stranger/ — decision 09. The structural pieces every case study
// shares (hero, tags, at-a-glance, outcome, learnings) live here, driven by
// the content schema; everything case-specific (the actual narrative,
// pull-quotes, figures, jump-nav) is free-form MDX body content.
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AtAGlance from '../components/AtAGlance.astro';

export async function getStaticPaths() {
	const caseStudies = await getCollection('case-studies');
	return caseStudies.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, heading, standfirst, description, eyebrow, tags, heroImage, atAGlance, outcome, learnings } =
	entry.data;
const heroWebp = heroImage.src.replace(/\.(jpe?g|png)$/i, '.webp');
---

<Layout title={title} description={description} ogImage={heroImage.src}>
	<section class="hero">
		<div class="wrap col">
			<p class="eyebrow">{eyebrow}</p>
			<h1>{heading}</h1>
			<p class="standfirst">{standfirst}</p>
		</div>
		<div class="breakout">
			<figure class="hero-figure">
				<picture>
					<source srcset={heroWebp} type="image/webp" />
					<img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={heroImage.alt} loading="eager" />
				</picture>
			</figure>
		</div>
	</section>

	<section class="wrap col">
		{
			tags.length > 0 && (
				<div class="tags">
					{tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)
		}
		<AtAGlance items={atAGlance} />
	</section>

	<section class="wrap col">
		<Content />
	</section>

	<section class="section section-alt">
		<div class="wrap col">
			<h2 class="mt-0">Outcome</h2>
			{/* Facts are still under revision with Nikos — approved is the fact-grid shape, not this exact wording. */}
			<div class="fact-grid">
				<div class="accent">
					<span class="stat">2.4 → 9.5<small style="font-size: 0.5em;">/10</small></span>
					<span class="stat-label">AI-readiness score after the skill shipped</span>
				</div>
				<div><p>Adopted as the team-wide standard, not just something I used on my own work.</p></div>
				<div><p>A developer and a US backend team shipped real code from my specs.</p></div>
			</div>

			<h2>Learnings</h2>
			<div class="fact-grid">
				<div class="accent blue">
					<span class="stat" style="font-size: var(--fs-h3);">Screens show it. Specs say how it behaves.</span>
					<span class="stat-label">Mixing the two is what broke our AI-readability</span>
				</div>
				<div><p>My job shifted: defining constraints and judging what comes back, not just handing off a screen.</p></div>
				<div><p>None of it worked solo. Developers were in it from week one, every time.</p></div>
			</div>
		</div>
	</section>
</Layout>
