---
// One template for every object in the collection, built as a catalogue
// entry. Case studies (01 to 03, collection 'case-studies') open with the
// title, standfirst, then the label plate beside a four-line summary that
// links to the four fixed sections (The problem, What I did, How it went,
// What I learned); the MDX body places <FactGrid data={frontmatter.outcome} />
// and the learnings grid at the top of the last two. Compact entries (04 to
// 06, collection 'entries') share the same header, with outbound links in
// place of the summary, and a short body. Every object closes with the next
// one in the collection and a way to get in touch.
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LabelPlate from '../components/LabelPlate.astro';
import CaseMark from '../components/CaseMark.astro';
import SectionTrail from '../components/SectionTrail.astro';
import KForm from '../components/KForm.astro';
import { allObjects, nextObject } from '../data/collection';

export async function getStaticPaths() {
	const caseStudies = await getCollection('case-studies');
	const entries = await getCollection('entries');
	return [...caseStudies, ...entries].map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, heading, standfirst, description, heroImage, atAGlance } = entry.data;
const isCaseStudy = entry.collection === 'case-studies';
const heroVideo = isCaseStudy ? entry.data.heroVideo : undefined;
const heroVideoCaption = isCaseStudy ? entry.data.heroVideoCaption : undefined;
const summary = isCaseStudy ? entry.data.summary : undefined;
const cases = isCaseStudy ? (entry.data.cases ?? []) : [];
const rail = isCaseStudy ? entry.data.rail : undefined;
const links = isCaseStudy ? [] : (entry.data.links ?? []);
const record = isCaseStudy ? [] : (entry.data.record ?? []);
const heroWebp = heroImage.src.replace(/\.(jpe?g|png)$/i, '.webp');

const href = `/${entry.id}/`;
const object = allObjects.find((o) => o.href === href);
if (!object) throw new Error(`${href} is not in src/data/collection.ts`);
const next = nextObject(href);

// Year, medium and status come from the collection; the label plate keeps
// only the people-and-place rows from the at-a-glance frontmatter.
const plateFields = atAGlance.filter((f) => ['Role', 'Where', 'Worked with'].includes(f.label));

const summaryRows = summary
	? [
			{ id: 'problem', label: 'The problem', text: summary.problem },
			{ id: 'what-i-did', label: 'What I did', text: summary.did },
			{ id: 'how-it-went', label: 'How it went', text: summary.went },
			{ id: 'what-i-learned', label: 'What I learned', text: summary.learned },
		]
	: [];
---

<Layout title={title} description={description} ogImage={heroImage.src}>
	{rail && <SectionTrail slot="context" part="context" style={rail.style} items={rail.items} object={heading} form={object.form} />}
	{rail && <SectionTrail slot="progress" part="progress" style={rail.style} items={rail.items} object={heading} form={object.form} />}
	<article class:list={['obj', !isCaseStudy && 'obj-compact']} data-form={object.form}>
		<header class="obj-head">
			<div class="wrap">
				<h1 class="obj-title" style={`view-transition-name: obj-${object.no}`}>
					{heading}
					{object.form && <KForm form={object.form} class="obj-mark" />}
				</h1>
				<p class="obj-standfirst">{standfirst}</p>
				<div class="obj-record">
					<LabelPlate object={object} fields={plateFields} />
					{summaryRows.length > 0 && (
						<nav class="obj-summary" aria-label="Summary">
							{cases.length > 0 && (
								<ul class="obj-summary-key">
									{cases.map((c) => (
										<li><CaseMark mark={c.case} /><span class="cat-no">{c.no}</span>{c.name}</li>
									))}
								</ul>
							)}
							<ol>
								{summaryRows.map((row) => (
									<li>
										<a href={`#${row.id}`}>
											<span class="obj-summary-label">{row.label}</span>
											{typeof row.text === 'string'
												? <span class="obj-summary-text">{row.text}</span>
												: (
													<ul class="obj-summary-cases">
														{row.text.map((c) => (
															<li><CaseMark mark={c.case} /><span class="visually-hidden">Case {c.case}: </span>{c.text}</li>
														))}
													</ul>
												)}
										</a>
									</li>
								))}
							</ol>
						</nav>
					)}
					{!isCaseStudy && (
						<div class="obj-aside">
							{record.length > 0 && (
								<dl class="obj-summary obj-entry-record">
									{record.map((r) => (
										<div>
											<dt class="obj-summary-label">{r.label}</dt>
											<dd class="obj-summary-text">{r.text}</dd>
										</div>
									))}
								</dl>
							)}
					{links.length > 0 && (
						<ul class="obj-links">
							{links.map((l) => (
								<li>
									<a href={l.href} target="_blank" rel="noopener">
										{l.label}
										<span class="visually-hidden"> (opens in a new tab)</span>
									</a>
								</li>
							))}
						</ul>
					)}
						</div>
					)}
				</div>
			</div>
			<div class="wrap">
				{
					heroVideo ? (
						<>
							<figure class="hero-figure">
								<div class="hero-video">
									<video id="hero-video" width={heroImage.width} height={heroImage.height} poster={heroImage.src} muted autoplay loop playsinline>
										<source src={heroVideo} type="video/mp4" />
										<img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={heroImage.alt} loading="eager" />
									</video>
									<button type="button">Turn sound on</button>
								</div>
							</figure>
							{heroVideoCaption && <p class="fs-small media-caption">{heroVideoCaption}</p>}
						</>
					) : (
						<figure class="hero-figure">
							<picture>
								<source srcset={heroWebp} type="image/webp" />
								<img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={heroImage.alt} loading="eager" />
							</picture>
						</figure>
					)
				}
			</div>
		</header>

		<div class="case-body">
			<Content />
		</div>

		<nav class="obj-next" aria-label="Next in the collection">
			<div class="wrap">
				<a class="obj-next-link" href={next.href}>
					<span class="obj-next-title">
						<span class="cat-no">No. {next.no}</span>
						<span class="obj-next-name">
							{next.title}
							{next.form && <KForm form={next.form} class="obj-next-mark" />}
						</span>
					</span>
				</a>
				<p class="obj-next-contact">
					Want to talk about this work? <a href="mailto:niksaoul@gmail.com">niksaoul@gmail.com</a>, or <a href="/#work">back to the collection</a>.
				</p>
			</div>
		</nav>
	</article>
</Layout>
