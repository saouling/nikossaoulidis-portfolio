---
// Every case-study hero ends with the same shape: a row of label/value
// facts. Every existing instance also carries the same inline style
// override (`max-width: var(--container)`) by hand — baked in here once
// instead of repeated at every call site.
interface Props {
	items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<dl class="at-a-glance" style="max-width: var(--container)">
	{
		items.map((item) => (
			<div>
				<dt>{item.label}</dt>
				<dd>{item.value}</dd>
			</div>
		))
	}
</dl>
