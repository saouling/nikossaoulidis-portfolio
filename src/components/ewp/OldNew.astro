---
// EWP: real fragments of the old dashboard beside the redesign, from the
// live Readymag originals. Deliberately small: shown near their true pixel
// size, so the old UI reads as it did rather than blown up. The new form
// is cropped above its phone field.
const rows = [
	{
		what: 'Navigation',
		old: { src: 'old-sidebar', w: 169, h: 140, alt: 'The old sidebar: a blue bold heading, cloud icons for outgoing and incoming students, and a plus sign for requirements.' },
		now: { src: 'new-sidebar', w: 258, h: 128, alt: 'The new sidebar: the Applications section highlighted in magenta, with consistent icons for outgoing students, incoming students and requirements.' },
	},
	{
		what: 'Editing a value',
		old: { src: 'old-form', w: 524, h: 145, alt: 'An old form: blue labels, the current value printed as text above an empty new-value box, and placeholder values like www@ww.ww.' },
		now: { src: 'new-form', w: 484, h: 148, alt: 'A new form: labelled fields for account name and account email, in one consistent input style.' },
	},
	{
		what: 'Choosing from a list',
		old: { src: 'old-select', w: 242, h: 157, alt: 'An old field: a monospaced text area holding a subject code, 001 – Basic programmes and qualifications.' },
		now: { src: 'new-select', w: 382, h: 429, show: 260, alt: 'A new filter panel: collapsible sections for academic year and term, with a dropdown listing semesters, trimesters and full academic year.' },
	},
];
---

<figure class="oldnew wide">
	<table>
		<caption class="visually-hidden">Parts of the old dashboard beside the redesign</caption>
		<thead>
			<tr><td></td><th scope="col">Before</th><th scope="col">After</th></tr>
		</thead>
		<tbody>
			{rows.map((r) => (
				<tr>
					<th scope="row">{r.what}</th>
					{[r.old, r.now].map((i: { src: string; w: number; h: number; alt: string; show?: number }) => (
						<td>
							<picture>
								<source srcset={`/images/ewp/${i.src}.webp`} type="image/webp" />
								<img src={`/images/ewp/${i.src}.png`} width={i.w} height={i.h} alt={i.alt} loading="lazy" decoding="async" style={`max-width: min(100%, ${i.show ?? i.w}px)`} />
							</picture>
						</td>
					))}
				</tr>
			))}
		</tbody>
	</table>
	<figcaption>Real pieces of the old dashboard and the redesign, near their actual size.</figcaption>
</figure>

<style>
	.oldnew { margin-block: var(--space-6); }
	.oldnew table { width: 100%; border-collapse: collapse; table-layout: fixed; }
	.oldnew thead th {
		text-align: left;
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--ink);
		padding: 0 var(--space-3) var(--space-2) 0;
		border-bottom: 3px solid var(--ink);
	}
	.oldnew thead th:last-child { border-bottom-color: var(--red); }
	.oldnew thead td { width: 9rem; border-bottom: 3px solid var(--ink); }
	.oldnew tbody th {
		text-align: left;
		vertical-align: top;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: var(--fs-small);
		text-transform: uppercase;
		letter-spacing: .06em;
		color: var(--muted);
		padding: var(--space-3) var(--space-2) var(--space-3) 0;
		border-bottom: 1px solid var(--hairline);
	}
	.oldnew td { vertical-align: top; padding: var(--space-3) var(--space-3) var(--space-3) 0; border-bottom: 1px solid var(--hairline); }
	.oldnew img { display: block; height: auto; border: 1px solid var(--hairline); border-radius: 0; }
	@media (max-width: 599px) {
		.oldnew thead td { width: 0; padding: 0; }
		.oldnew tbody tr { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--space-3); border-bottom: 1px solid var(--hairline); }
		.oldnew tbody th { grid-column: 1 / -1; border: 0; padding-bottom: 0; }
		.oldnew tbody td { border: 0; }
		.oldnew thead tr { display: grid; grid-template-columns: 0 1fr 1fr; column-gap: var(--space-3); }
	}
	.oldnew figcaption { margin-top: var(--space-3); font-size: var(--fs-small); color: var(--muted); }
</style>
