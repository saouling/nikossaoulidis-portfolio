---
// The quote text itself (curly quotes and all) is the author's to write —
// it's a slot, not a prop, so it can carry inline markup. The em dash
// before an attribution is the one thing the component owns, so it's
// never typed inconsistently from one pull-quote to the next.
interface Props {
	cite?: string;
	/** 'boxed' (Session B11 round 5): an ink-bordered box with no fill,
	 * for a standout statement or question — reuses the same bordered-box
	 * language already visible in Nikos's own diagram titles (28/34),
	 * rather than the default left-rule blockquote. */
	variant?: 'default' | 'boxed';
}

const { cite, variant = 'default' } = Astro.props;
---

<blockquote class={variant === 'boxed' ? 'pull boxed' : 'pull'}>
	<slot />
	{cite && <cite>— {cite}</cite>}
</blockquote>
