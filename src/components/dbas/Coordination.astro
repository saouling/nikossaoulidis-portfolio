---
// DBAS: who I brought together, and how I ran it. Roles only, no names
// (the page names nobody it doesn't have to). Everything here is from the
// thesis: the collaborators in its acknowledgements and museum chapter,
// the 12 site visits (8 at Röhsska, 4 at Mölndal, not counting the ones
// before the agreements), what I prepared before each meeting and what I
// sent after, and that I did every part alone, from hardware to thesis.
// Museum colour-coding as elsewhere: red Röhsska, blue Mölndal.
const groups = [
	{ name: 'Röhsska', tone: 'red', roles: ['Curator and exhibition producer', 'Graphic designer', 'Curator of pedagogy', 'Technicians, guides, reception'] },
	{ name: 'Mölndals stadsmuseum', tone: 'blue', roles: ['Museum educator and coordinator', 'Communicator', 'Technicians, guides, reception'] },
	{ name: 'Chalmers', tone: 'ink', roles: ['Supervisor and examiner', 'Interaction design students'] },
	{ name: 'People and parts', tone: 'ink', roles: ['25 pilot participants', 'Five second-hand sellers', 'The mobile operator'] },
];
const ran = [
	{ n: '12', what: 'site visits and meetings: 8 at Röhsska, 4 at Mölndal' },
	{ n: 'Before', what: 'each one, visual presentations and printed mockups to make ideas concrete' },
	{ n: 'After', what: 'each one, decisions written up, next steps proposed, open questions reopened' },
	{ n: 'Tasks', what: 'split into checklists and handed to each person by expertise' },
];
---

<figure class="coord wide">
	<div class="coord-map">
		<div class="coord-me" aria-hidden="true">
			<span>Me</span>
			<small>sole designer and researcher</small>
		</div>
		{groups.map((g) => (
			<section class:list={['coord-group', `tone-${g.tone}`]}>
				<h4>{g.name}</h4>
				<ul>{g.roles.map((r) => <li>{r}</li>)}</ul>
			</section>
		))}
	</div>
	<ol class="coord-ran">
		{ran.map((r) => (
			<li><span class="coord-n">{r.n}</span><span>{r.what}</span></li>
		))}
	</ol>
	<figcaption>Everyone the installation needed, and the one person in the middle. Nobody on this map worked for me.</figcaption>
</figure>

<style>
	.coord { margin-block: var(--space-6); }
	.coord-map {
		position: relative;
		display: grid;
		gap: var(--space-3);
		grid-template-columns: 1fr;
	}
	@media (min-width: 800px) {
		.coord-map {
			grid-template-columns: 1fr 12rem 1fr;
			grid-template-rows: auto auto;
			column-gap: var(--space-4);
			row-gap: var(--space-4);
			align-items: stretch;
		}
		.coord-me { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
		.coord-group:nth-of-type(1) { grid-column: 1; grid-row: 1; }
		.coord-group:nth-of-type(2) { grid-column: 3; grid-row: 1; }
		.coord-group:nth-of-type(3) { grid-column: 1; grid-row: 2; }
		.coord-group:nth-of-type(4) { grid-column: 3; grid-row: 2; }
		/* the lines from the middle out to each group */
		.coord-map::before {
			content: "";
			position: absolute;
			left: 18%;
			right: 18%;
			top: 25%;
			bottom: 25%;
			border-top: 1px solid var(--ink);
			border-bottom: 1px solid var(--ink);
			z-index: 0;
		}
	}
	.coord-me {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		align-content: center;
		width: 12rem;
		aspect-ratio: 1;
		justify-self: center;
		border-radius: 50%;
		background: var(--ink);
		color: var(--on-dark);
		text-align: center;
		font-family: var(--font-display);
	}
	.coord-me span { font-size: var(--fs-h2); font-weight: 600; line-height: 1; }
	.coord-me small { margin-top: var(--space-1); font-size: .8rem; max-width: 8rem; line-height: 1.3; }
	@media (max-width: 799px) { .coord-me { width: 9rem; } }
	.coord-group { position: relative; z-index: 1; background: var(--bg); border: 1px solid var(--ink); padding: var(--space-3) var(--space-4); }
	.coord-group.tone-red { box-shadow: inset 0 5px 0 var(--red); padding-top: calc(var(--space-3) + 5px); }
	.coord-group.tone-blue { box-shadow: inset 0 5px 0 var(--blue); padding-top: calc(var(--space-3) + 5px); }
	.coord-group h4 { margin: 0 0 var(--space-2); font-family: var(--font-display); font-weight: 600; font-size: var(--fs-body); color: var(--ink); }
	.coord-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font-family: var(--font-display); font-size: var(--fs-small); color: var(--body); }
	.coord-ran { list-style: none; margin: var(--space-5) 0 0; padding: 0; display: grid; gap: 0; border-top: 3px solid var(--ink); }
	@media (min-width: 800px) { .coord-ran { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--space-4); } }
	.coord-ran li { display: grid; gap: var(--space-1); padding: var(--space-3) 0; border-bottom: 1px solid var(--hairline); font-size: var(--fs-small); line-height: 1.45; color: var(--body); }
	.coord-n { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); color: var(--ink); }
	.coord figcaption { margin-top: var(--space-3); font-size: var(--fs-small); color: var(--muted); }
</style>
