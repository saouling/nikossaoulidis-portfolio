---
// DBAS: a rotary dial you can use. Click (or focus and press) a finger
// hole and the plate turns to the finger stop and runs back, slowly, the
// way the real one does. After seven digits it rings, with the Swedish
// ringback tone (425 Hz, one second on, five off), and then, like many of
// the real calls, nobody answers. The point is the friction and the
// waiting, not a result. Drawn in DBAS's circle blue.
//
// Geometry: angles are degrees clockwise from twelve o'clock. The finger
// stop sits at 120°. Digit n (1–9, with 0 as 10) sits 30 + 30n degrees
// before the stop, so dialling n turns the plate 30 + 30n degrees.
const C = 100;
const R = 68;
const STOP = 120;
const digits = [1, 2, 3, 4, 5, 6, 7, 8, 9, 0];
const pos = (d: number) => {
	const n = d === 0 ? 10 : d;
	const a = ((STOP - (30 + 30 * n)) * Math.PI) / 180;
	return { x: C + R * Math.sin(a), y: C - R * Math.cos(a), travel: 30 + 30 * n };
};
const holes = digits.map((d) => ({ d, ...pos(d) }));
// The plate: a disc minus ten finger holes and the centre card.
const disc = `M ${C - 96} ${C} a 96 96 0 1 0 192 0 a 96 96 0 1 0 -192 0 Z`;
const hole = (x: number, y: number, r: number) => `M ${x - r} ${y} a ${r} ${r} 0 1 0 ${2 * r} 0 a ${r} ${r} 0 1 0 ${-2 * r} 0 Z`;
const plate = [disc, ...holes.map((h) => hole(h.x, h.y, 14)), hole(C, C, 38)].join(' ');
const stopA = (STOP * Math.PI) / 180;
---

<figure class="dial" data-dial>
	<div class="dial-body">
		<svg class="dial-svg" viewBox="0 0 200 200" role="group" aria-label="A rotary dial. Choose a finger hole to dial that digit.">
			<circle class="dial-card" cx={C} cy={C} r="96" />
			{holes.map((h) => <text class="dial-num" x={h.x} y={h.y} dy="0.35em" aria-hidden="true">{h.d}</text>)}
			<g class="dial-plate" data-plate>
				<path d={plate} fill-rule="evenodd" />
			</g>
			<circle class="dial-centre" cx={C} cy={C} r="36" />
			<text class="dial-centre-text" x={C} y={C - 4} aria-hidden="true">Don’t be</text>
			<text class="dial-centre-text" x={C} y={C + 9} aria-hidden="true">a stranger</text>
			<path class="dial-stop" d={`M ${C + 84 * Math.sin(stopA)} ${C - 84 * Math.cos(stopA)} L ${C + 104 * Math.sin(stopA)} ${C - 104 * Math.cos(stopA)}`} />
			{holes.map((h) => (
				<circle class="dial-hole" cx={h.x} cy={h.y} r="14" tabindex="0" role="button" aria-label={`Dial ${h.d}`} data-digit={h.d} data-travel={h.travel} />
			))}
		</svg>
		<div class="dial-side">
			<p class="dial-number" aria-hidden="true" data-number>
				{Array.from({ length: 7 }, () => <span>&nbsp;</span>)}
			</p>
			<p class="dial-status" data-status aria-live="polite">Dial any seven digits.</p>
			<div class="dial-controls">
				<button type="button" class="dial-btn" data-hangup>Hang up</button>
				<button type="button" class="dial-btn" data-sound aria-pressed="true">Sound on</button>
			</div>
		</div>
	</div>
	<figcaption>Try the dial. It is slow on purpose: the plate always runs back at its own pace, the way the real mechanism does.</figcaption>
</figure>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-dial]')) {
		const plate = root.querySelector<SVGGElement>('[data-plate]')!;
		const number = root.querySelector<HTMLElement>('[data-number]')!;
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const hangup = root.querySelector<HTMLButtonElement>('[data-hangup]')!;
		const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound]')!;
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let dialled: number[] = [];
		let busy = false;
		let ringing = false;
		let sound = true;
		let timers: number[] = [];
		let ctx: AudioContext | null = null;
		let osc: OscillatorNode | null = null;

		const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
		const show = () => {
			[...number.children].forEach((s, i) => (s.textContent = i < dialled.length ? String(dialled[i]) : '\u00a0'));
		};
		const tone = (on: boolean) => {
			if (!sound) return;
			try {
				ctx ??= new AudioContext();
				if (on) {
					osc = ctx.createOscillator();
					const gain = ctx.createGain();
					gain.gain.value = 0.04;
					osc.frequency.value = 425;
					osc.connect(gain).connect(ctx.destination);
					osc.start();
				} else {
					osc?.stop();
					osc = null;
				}
			} catch { /* no audio: the dial still works silently */ }
		};
		const reset = (msg = 'Dial any seven digits.') => {
			timers.forEach(clearTimeout);
			timers = [];
			tone(false);
			dialled = [];
			busy = false;
			ringing = false;
			plate.style.transition = 'none';
			plate.style.transform = '';
			root.classList.remove('is-ringing');
			show();
			status.textContent = msg;
		};
		const ring = () => {
			ringing = true;
			root.classList.add('is-ringing');
			status.textContent = 'Ringing…';
			// Three rings: one second of tone, five seconds of quiet.
			for (let i = 0; i < 3; i++) {
				later(i * 6000, () => tone(true));
				later(i * 6000 + 1000, () => tone(false));
			}
			later(15000, () => {
				root.classList.remove('is-ringing');
				ringing = false;
				status.textContent = 'No answer. You might connect. You might not. But the moment is yours.';
			});
		};
		const dial = (d: number, travel: number) => {
			if (busy || ringing || dialled.length >= 7) return;
			busy = true;
			const forward = still ? 0 : travel * 3.2;
			const back = still ? 0 : travel * 5.5;
			plate.style.transition = `transform ${forward}ms cubic-bezier(.3,.1,.3,1)`;
			plate.style.transform = `rotate(${travel}deg)`;
			later(forward + (still ? 0 : 120), () => {
				plate.style.transition = `transform ${back}ms linear`;
				plate.style.transform = 'rotate(0deg)';
				later(back, () => {
					busy = false;
					dialled.push(d);
					show();
					if (dialled.length === 7) ring();
					else status.textContent = `${7 - dialled.length} to go.`;
				});
			});
		};

		root.querySelectorAll<SVGCircleElement>('[data-digit]').forEach((h) => {
			const go = () => dial(Number(h.dataset.digit), Number(h.dataset.travel));
			h.addEventListener('click', go);
			h.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
			});
		});
		root.addEventListener('keydown', (e) => {
			if (/^[0-9]$/.test(e.key)) {
				const h = root.querySelector<SVGCircleElement>(`[data-digit="${e.key}"]`);
				if (h) dial(Number(e.key), Number(h.dataset.travel));
			}
		});
		hangup.addEventListener('click', () => reset());
		soundBtn.addEventListener('click', () => {
			sound = !sound;
			if (!sound) tone(false);
			soundBtn.setAttribute('aria-pressed', String(sound));
			soundBtn.textContent = sound ? 'Sound on' : 'Sound off';
		});
	}
</script>

<style>
	.dial { margin-block: var(--space-6); }
	.dial-body { display: grid; gap: var(--space-4); align-items: center; }
	@media (min-width: 600px) {
		.dial-body { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: var(--space-6); }
	}
	.dial-svg { width: 100%; max-width: 20rem; height: auto; display: block; overflow: visible; }
	.dial-card { fill: var(--bg); stroke: var(--ink); stroke-width: 1.5; }
	.dial-num { font-family: var(--font-display); font-size: 13px; text-anchor: middle; fill: var(--ink); }
	.dial-plate { transform-origin: 100px 100px; }
	.dial-plate path { fill: var(--blue); }
	.dial-centre { fill: var(--bg); stroke: var(--ink); stroke-width: 1; }
	.dial-centre-text { font-family: var(--font-display); font-size: 8.5px; text-anchor: middle; fill: var(--ink); }
	.dial-stop { stroke: var(--ink); stroke-width: 5; stroke-linecap: butt; }
	.dial-hole { fill: transparent; cursor: pointer; outline: none; }
	.dial-hole:hover, .dial-hole:focus-visible { stroke: var(--blue-ink); stroke-width: 2.5; }
	.dial.is-ringing .dial-svg { animation: dial-shake 1s steps(8) 0s 1; }

	.dial-number { display: flex; gap: .4em; margin: 0; font-family: var(--font-display); font-size: var(--fs-h2); font-variant-numeric: tabular-nums; color: var(--ink); }
	.dial-number span { min-width: .7em; text-align: center; border-bottom: 2px solid var(--ink); }
	.dial-status { margin: var(--space-3) 0 0; min-height: 3em; font-family: var(--font-body); font-style: italic; color: var(--ink); max-width: 30ch; }
	.dial-controls { display: flex; gap: var(--space-2); margin-top: var(--space-3); }
	.dial-btn {
		font: inherit;
		font-family: var(--font-display);
		font-size: var(--fs-small);
		padding: 6px 12px;
		border: 1px solid var(--ink);
		background: var(--bg);
		color: var(--ink);
		cursor: pointer;
	}
	.dial-btn:hover { border-color: var(--blue-ink); color: var(--blue-ink); }
	.dial figcaption { margin-top: var(--space-3); font-size: var(--fs-small); color: var(--muted); }
	@keyframes dial-shake { 0%, 100% { transform: none; } 25% { transform: rotate(-1.5deg); } 75% { transform: rotate(1.5deg); } }
	@media (prefers-reduced-motion: reduce) { .dial.is-ringing .dial-svg { animation: none; } }
</style>
