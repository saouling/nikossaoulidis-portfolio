---
import CaseMark from './CaseMark.astro';
// A sub-record inside one catalogue object (Ericsson's three cases, 01a to
// 01c): its heading plus a small label with my part and the result. It
// renders only the heading and label, never wraps the case's content, so
// breakout figures stay direct children of the case-body grid.
interface Props {
	id: string;
	no: string;
	title: string;
	lead: string;
	part: string;
	result: string;
	mark: 'a' | 'b' | 'c';
	/** The project's plain name, when the title is a takeaway instead. */
	project?: string;
}

const { id, no, title, lead, part, result, mark, project } = Astro.props;
---

<h3 class="sub-title" id={id}><CaseMark mark={mark} class="sub-mark" /><span class="cat-no">{project ? `${no} · ${project}` : no}</span><span>{title}</span></h3>
<p class="sub-lead">{lead}</p>
<dl class="sub-plate">
	<div>
		<dt>My part</dt>
		<dd>{part}</dd>
	</div>
	<div>
		<dt>Result</dt>
		<dd>{result}</dd>
	</div>
</dl>
