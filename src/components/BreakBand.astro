---
// A full-bleed tinted band (Don't Be a Stranger's three "refusal" moments).
// Two of the three existing instances hold a single blockquote in the
// narrow measure-width column (`wrap col`); one holds a wider 3-column
// grid of headed text and needs the plain, un-narrowed `wrap`. `wide`
// is that one real variation — everything else about the band is fixed.
interface Props {
	wide?: boolean;
}

const { wide = false } = Astro.props;
---

<div class="break-band">
	<div class={wide ? 'wrap' : 'wrap col'}>
		<slot />
	</div>
</div>
