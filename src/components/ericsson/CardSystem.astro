---
// Ericsson 01c: the static card versus the content-driven card, as a live
// layout rather than a picture. The left grid is fixed-size cells that
// clip what they hold; the right grid is real CSS grid with auto-fill and
// content-driven spans, so it actually reflows as the window changes.
// Content is abstract (NDA): kinds of card, not product data.
const dynamicCards = [
	{ kind: 'KPI', size: 'sm' },
	{ kind: 'Trend', size: 'wide' },
	{ kind: 'KPI', size: 'sm' },
	{ kind: 'Table', size: 'tall' },
	{ kind: 'Status', size: 'sm' },
	{ kind: 'Trend', size: 'wide' },
	{ kind: 'KPI', size: 'sm' },
	{ kind: 'Table', size: 'tall' },
	{ kind: 'Status', size: 'sm' },
	{ kind: 'Trend', size: 'wide' },
	{ kind: 'KPI', size: 'sm' },
	{ kind: 'Status', size: 'sm' },
];
---

<figure class="cards">
	<div class="cards-panels">
		<div class="cards-panel">
			<p class="cards-tag"><span>Static card</span> fixed width, fixed height</p>
			<div class="cards-static" role="img" aria-label="A three by three grid of identical fixed-size cards; long content is cut off at the edges.">
				{Array.from({ length: 9 }, (_, i) => (
					<div class:list={['c-static', i === 1 && 'overflow', i === 5 && 'overflow']}>
						<span class="c-line" />
						<span class="c-bars" />
					</div>
				))}
			</div>
			<ul class="cards-notes">
				<li>Breaks the moment a layout becomes dynamic</li>
				<li>Limits what data can be shown at all</li>
			</ul>
		</div>
		<div class="cards-panel">
			<p class="cards-tag"><span>Dynamic card</span> width and height follow the content</p>
			<div class="cards-dynamic" role="img" aria-label="A grid of cards of different sizes: small KPI cards, wide trend cards and a tall table card, packed to follow their content and reflowing with the available width.">
				{dynamicCards.map((c) => (
					<div class={`c-dyn ${c.size}`}>
						<span class="c-kind">{c.kind}</span>
						{c.kind === 'Trend' && <span class="c-trend" />}
						{c.kind === 'Table' && <span class="c-rows" />}
						{(c.kind === 'KPI' || c.kind === 'Status') && <span class="c-big" />}
					</div>
				))}
			</div>
			<ul class="cards-notes">
				<li>Responds to whatever width the grid gives it</li>
				<li>One component instead of a set of special cases</li>
			</ul>
		</div>
	</div>
	<figcaption>A live layout, not a picture: the right-hand grid reflows as the window narrows.</figcaption>
</figure>

<style>
	.cards { margin: 0; }
	.cards-panels { display: grid; gap: var(--space-4); }
	@media (min-width: 900px) {
		.cards-panels { grid-template-columns: 1fr 1fr; }
	}
	.cards-panel { border: 1px solid var(--ink); display: flex; flex-direction: column; }
	.cards-tag {
		margin: 0;
		max-width: none;
		padding: var(--space-2) var(--space-3);
		border-bottom: 1px solid var(--ink);
		font-family: var(--font-display);
		font-size: var(--fs-small);
		color: var(--body);
	}
	.cards-tag span { text-transform: uppercase; letter-spacing: .06em; color: var(--red-ink); margin-right: var(--space-2); }
	.cards-notes {
		margin: 0;
		padding: var(--space-2) var(--space-3) var(--space-3);
		list-style: none;
		font-size: var(--fs-small);
		color: var(--body);
		border-top: 1px solid var(--hairline);
	}
	.cards-notes li + li { margin-top: 2px; }

	.cards-static {
		flex: 1;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 8px;
		padding: var(--space-3);
		background: var(--bg-alt);
		align-content: start;
	}
	.c-static {
		height: 72px;
		overflow: hidden;
		background: var(--bg);
		border: 1px solid var(--ink);
		padding: 8px;
		display: grid;
		gap: 6px;
		align-content: start;
	}
	.c-line { height: 3px; width: 60%; background: var(--hairline); }
	.c-bars {
		height: 36px;
		background: repeating-linear-gradient(to right, var(--ink) 0 6px, transparent 6px 11px);
		mask: linear-gradient(to top, #000 55%, transparent 55%);
		opacity: .35;
	}
	.c-static.overflow .c-bars {
		height: 120px;
		width: 160%;
		opacity: .6;
		mask: none;
		background: repeating-linear-gradient(to right, var(--gold) 0 8px, transparent 8px 13px);
	}

	.cards-dynamic {
		flex: 1;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
		grid-auto-rows: 60px;
		grid-auto-flow: dense;
		gap: 8px;
		padding: var(--space-3);
		background: var(--bg-alt);
	}
	.c-dyn {
		background: var(--bg);
		border: 1px solid var(--ink);
		padding: 8px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}
	.c-dyn.wide { grid-column: span 2; }
	.c-dyn.tall { grid-row: span 2; }
	.c-kind { font-family: var(--font-display); font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
	.c-big { height: 16px; width: 55%; background: var(--ink); }
	.c-trend {
		flex: 1;
		background:
			linear-gradient(to top right, transparent calc(50% - 1px), var(--gold) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)) 0 0 / 34% 100% no-repeat,
			linear-gradient(to bottom right, transparent calc(50% - 1px), var(--gold) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)) 50% 0 / 34% 100% no-repeat,
			linear-gradient(to top right, transparent calc(50% - 1px), var(--gold) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)) 100% 0 / 34% 100% no-repeat;
	}
	.c-rows { flex: 1; background: repeating-linear-gradient(to bottom, var(--hairline) 0 2px, transparent 2px 12px); }
	.cards figcaption { margin-top: var(--space-2); font-size: var(--fs-small); color: var(--muted); }
</style>
