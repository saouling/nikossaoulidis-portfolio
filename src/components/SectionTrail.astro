---
// "Where am I", in the site header itself: after the name, the object
// and the case or step being read, and along the header's bottom edge a
// progress line split into one segment per section, filling in the
// object's own colour (gold Ericsson, blue DBAS, red EWP). The header
// already stays put, so nothing appears, disappears or moves; only the
// words and the fill change. Each object speaks its own language:
//   cases  · Ericsson: the current case's poster letter, number and name
//   call   · DBAS: the call step, with its live state (dialling…, ringing…)
//   status · EWP: plain section names
// Without JS: the object name only, and no line.
import CaseMark from './CaseMark.astro';
import type { Form } from '../data/collection';

interface Item {
	id: string;
	label: string;
	mark?: 'a' | 'b' | 'c';
	no?: string;
	state?: string;
}
interface Props {
	style: 'cases' | 'call' | 'status';
	items: Item[];
	object: string;
	form?: Form;
	part: 'context' | 'progress';
}
const { style, items, object, form, part } = Astro.props;
const tone = form === 'circle' ? 'blue' : form === 'square' ? 'red' : 'gold';
---

{part === 'context' && (
	<p class:list={['trail', `trail-${style}`]} data-trail aria-live="off">
		<span class="trail-sep" aria-hidden="true">/</span>
		<a class="trail-object" href="#top">{object}</a>
		<span class="trail-now" data-trail-now hidden>
			<span class="trail-sep" aria-hidden="true">/</span>
			{style === 'cases' && items.map((it) => it.mark && <CaseMark mark={it.mark} class={`trail-mark trail-mark-${it.id}`} />)}
			<span data-trail-label></span>
		</span>
	</p>
)}
{part === 'progress' && (
	<div class:list={['trail-line', `tone-${tone}`]} data-trail-line aria-hidden="true" hidden>
		{items.map((it) => (
			<span class="trail-seg" data-seg={it.id} data-label={it.no ? `${it.no} · ${it.label}` : it.label} data-state={it.state ?? ''}><i></i></span>
		))}
	</div>
)}

{part === 'progress' && (
	<script>
		const line = document.querySelector<HTMLElement>('[data-trail-line]');
		const trail = document.querySelector<HTMLElement>('[data-trail]');
		const body = document.querySelector<HTMLElement>('.case-body');
		if (line && trail && body) {
			const segs = [...line.querySelectorAll<HTMLElement>('[data-seg]')];
			const targets = segs.map((s) => document.getElementById(s.dataset.seg!));
			const now = trail.querySelector<HTMLElement>('[data-trail-now]')!;
			const label = trail.querySelector<HTMLElement>('[data-trail-label]')!;
			line.hidden = false;
			let ticking = false;

			// Each segment's width is its section's share of the case body.
			const size = () => {
				const top = body.getBoundingClientRect().top + scrollY;
				const end = top + body.offsetHeight;
				const starts = targets.map((t) => (t ? t.getBoundingClientRect().top + scrollY : top));
				segs.forEach((s, i) => {
					const a = i === 0 ? Math.min(starts[0], top) : starts[i];
					const b = i === segs.length - 1 ? end : starts[i + 1];
					s.style.flexGrow = String(Math.max(1, b - a));
					s.dataset.a = String(a);
					s.dataset.b = String(b);
				});
			};
			const update = () => {
				ticking = false;
				const y = scrollY + innerHeight * 0.35;
				let cur = -1;
				segs.forEach((s, i) => {
					const a = Number(s.dataset.a), b = Number(s.dataset.b);
					const f = Math.min(1, Math.max(0, (y - a) / (b - a)));
					s.style.setProperty('--f', String(f));
					if (y >= a) cur = i;
				});
				const first = Number(segs[0]?.dataset.a ?? 0);
				const c = y >= first ? segs[cur] : undefined;
				now.hidden = !c;
				trail.dataset.current = c?.dataset.seg ?? '';
				if (c) {
					const text = `${c.dataset.label}${c.dataset.state ? ` · ${c.dataset.state}` : ''}`;
					if (label.textContent !== text) label.textContent = text;
				}
			};
			const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
			size();
			update();
			addEventListener('scroll', onScroll, { passive: true });
			addEventListener('resize', () => { size(); update(); });
			addEventListener('load', () => { size(); update(); });
		}
	</script>
)}

<style>
	.trail {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
		min-width: 0;
		font-family: var(--font-display);
		font-size: var(--fs-small);
		color: var(--muted);
		white-space: nowrap;
	}
	.trail-sep { color: var(--hairline); }
	.trail-object { color: var(--muted); text-decoration: none; }
	.trail-object:hover, .trail-object:focus-visible { color: var(--blue-ink); }
	.trail-now { display: inline-flex; align-items: center; gap: var(--space-2); min-width: 0; color: var(--ink); }
	.trail-now[hidden] { display: none; }
	.trail-now > span:last-child { overflow: hidden; text-overflow: ellipsis; }
	.trail :global(.trail-mark) { display: none; font-size: 1rem; }
	.trail-cases[data-current="case-1"] :global(.trail-mark-case-1),
	.trail-cases[data-current="case-2"] :global(.trail-mark-case-2),
	.trail-cases[data-current="case-3"] :global(.trail-mark-case-3) { display: inline-block; }
	@media (max-width: 699px) {
		/* Phones: the object name gives way to where you are. */
		.trail-object, .trail-object + .trail-sep, .trail > .trail-sep:first-child { display: none; }
		.trail { max-width: 55vw; }
	}

	.trail-line {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 3px;
		display: flex;
		gap: 3px;
	}
	.trail-line[hidden] { display: none; }
	.trail-seg { flex: 1 1 0; background: var(--hairline); overflow: hidden; }
	.trail-seg i { display: block; height: 100%; transform-origin: left; transform: scaleX(var(--f, 0)); }
	.tone-gold .trail-seg i { background: var(--gold); }
	.tone-blue .trail-seg i { background: var(--blue); }
	.tone-red .trail-seg i { background: var(--red); }
</style>
