.DS_Store

# Astro / node — created during the rebuild, never committed
node_modules/
dist/
.astro/
.vercel/
.env
.env.production
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.idea/

# Impeccable's downloaded platform engine binary — re-fetched by `npx impeccable
# install`/first run, not portable across platforms, no reason to version it.
.claude/skills/impeccable/scripts/bin/

# Personal Claude Code overrides — shared hooks live in .claude/settings.json
.claude/settings.local.json

# Impeccable local artifacts: decision-page answers and review captures
.impeccable/questions/
.impeccable/review/

# Raw text extracts of the source decks, thesis and CV. Local only: the repo is
# public and some sources are marked Ericsson Internal or contain personal data.
# The committed, publishable summary is reference/PROJECT-REFERENCE.md.
reference/sources/

# Temporary capture helpers used during review; never ship
public/_viz*.html
public/_review*.html
